    "LectureLift braucht die Berechtigung „Bildschirm- & Systemaudioaufnahme“. Bis dahin hörst du den Originalton.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LectureLift braucht die Berechtigung „Bildschirm- & Systemaudioaufnahme“. Bis dahin hörst du den Originalton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LectureLift needs the “Screen & System Audio Recording” permission. Until then you hear the original audio."
