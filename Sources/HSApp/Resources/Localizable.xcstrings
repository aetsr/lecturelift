    "DeepFilterNet3 entfernt Rauschen und etwas Nachhall. Mehr Rechenlast (bis 12 %) und ca. 60 ms zusätzliche Verzögerung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepFilterNet3 entfernt Rauschen und etwas Nachhall. Mehr Rechenlast (bis 12 %) und ca. 60 ms zusätzliche Verzögerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepFilterNet3 removes noise and some reverb. Higher CPU load (up to 12 %) and about 60 ms extra delay."
          }
        }
      }
    },
