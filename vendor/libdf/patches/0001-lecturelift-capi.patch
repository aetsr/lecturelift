+// ---- LectureLift additions (MIT/Apache, see the LectureLift repo): no panics across the FFI boundary ----
+
+/// Like `df_create`, mono, with explicit local-SNR thresholds. Returns NULL on any error instead of
+/// panicking (a panic across FFI would abort the host app).
+#[no_mangle]
+pub unsafe extern "C" fn hs_df_create(
+    path: *const c_char,
+    atten_lim: f32,
+    min_db_thresh: f32,
+    max_db_erb_thresh: f32,
+    max_db_df_thresh: f32,
+) -> *mut DFState {
+    if path.is_null() {
+        return std::ptr::null_mut();
+    }
+    let r = std::panic::catch_unwind(|| {
+        let p = CStr::from_ptr(path).to_str().ok()?;
+        let r_params = RuntimeParams::default_with_ch(1)
+            .with_atten_lim(atten_lim)
+            .with_thresholds(min_db_thresh, max_db_erb_thresh, max_db_df_thresh)
+            .with_post_filter(0.0f32)
+            .with_mask_reduce(ReduceMask::MAX);
+        let df_params = DfParams::new(PathBuf::from(p)).ok()?;
+        let m = DfTract::new(df_params, &r_params).ok()?;
+        Some(Box::into_raw(Box::new(DFState { m, logger: None })))
+    });
+    match r {
+        Ok(Some(p)) => p,
+        _ => std::ptr::null_mut(),
+    }
+}
+
+/// Like `df_process_frame`, but returns NaN on error instead of panicking.
+#[no_mangle]
+pub unsafe extern "C" fn hs_df_process_frame(
+    st: *mut DFState,
+    input: *mut c_float,
+    output: *mut c_float,
+) -> c_float {
+    let Some(state) = st.as_mut() else { return f32::NAN };
+    if input.is_null() || output.is_null() {
+        return f32::NAN;
+    }
+    let hop = state.m.hop_size;
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let input = ArrayView2::from_shape_ptr((1, hop), input);
+        let output = ArrayViewMut2::from_shape_ptr((1, hop), output);
+        state.m.process(input, output).unwrap_or(f32::NAN)
+    }))
+    .unwrap_or(f32::NAN)
+}
